# Postgres. On Aiven Runtime this is injected (Aiven for PostgreSQL).
DATABASE_URL=postgres://app:app@localhost:5432/app
# Valkey/Redis. On Aiven Runtime VALKEY_URL is injected (Aiven for Valkey).
VALKEY_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
# Model for briefs, chat and onboarding; SCORING_MODEL for bulk tender scoring.
MODEL=anthropic/claude-sonnet-5
SCORING_MODEL=anthropic/claude-haiku-5-5
# Minutes between TED sweeps; WATCHER=off disables the background watcher.
SCAN_EVERY_MIN=30
PORT=3000
