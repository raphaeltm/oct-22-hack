DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
KEENABLE_API_KEY=
MODEL=anthropic/claude-sonnet-5
# Model for bulk tender scoring (cheaper/faster); defaults to MODEL
SCORING_MODEL=anthropic/claude-haiku-5-5
# Minutes between TED sweeps; WATCHER=off disables the background watcher
SCAN_EVERY_MIN=30
PORT=3000
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
