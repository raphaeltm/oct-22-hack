{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -e \"import('./src/db/index.ts').then(async (m) => { await m.runMigrations(); await m.pool.end(); })\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mastra/core": "^1.79.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/pg": "^1.32.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
